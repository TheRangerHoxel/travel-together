{
  "name": "app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.27",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@expo/env": "^2.4.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-plugin-boundaries": "^7.2.0",
    "jest": "^30.5.2",
    "jest-expo": "^57.0.5",
    "postgres": "^3.4.9",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.int.json",
    "test:unit": "jest --config jest.unit.config.js --ci",
    "test:int": "jest --config jest.int.config.js --ci",
    "smoke": "expo export --platform android --output-dir dist && jest --config jest.smoke.config.js --ci",
    "db:preflight": "node scripts/db-preflight.js",
    "db:status": "node scripts/supabase-db.js status",
    "db:push": "node scripts/supabase-db.js push",
    "verify": "node scripts/verify.js"
  },
  "private": true,
  "overrides": {
    "handlebars": "4.7.10",
    "braces": "3.0.3",
    "micromatch": "4.0.8",
    "node-forge": "1.4.0"
  }
}
