# Nomi delle variabili, con valori FINTI. Questo file sta nel repo; .env no.
# Copiare in .env e riempire coi valori del progetto Supabase di STAGING.
#
# La chiave qui sotto e' quella PUBBLICA (publishable / anon): puo' stare
# nell'app perche' da sola non scavalca le policy RLS.
# La chiave SEGRETA (sb_secret_...) non va mai in questo file, ne' in .env,
# ne' nel codice: serve solo alle migrazioni, eseguite a mano.

EXPO_PUBLIC_SUPABASE_URL=https://esempio-staging.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_valore-finto-da-sostituire
EXPO_PUBLIC_INVITE_CODE=codice-finto-da-sostituire