{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoContinueAtUsageLimit": true,
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git add -f:*)",
      "Bash(git add --force:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git push --force-with-lease:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean -f:*)",
      "PowerShell(git clean -fd:*)",
      "PowerShell(git clean -fdx:*)",
      "PowerShell(git filter-branch:*)",
      "PowerShell(git filter-repo:*)",
      "PowerShell(git push origin main:*)",
      "PowerShell(git push origin master:*)",
      "PowerShell(git add -f:*)",
      "PowerShell(git add --force:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/*.pem)",
      "Read(./**/*.p12)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./.claude/settings.json)",
      "Write(./.claude/hooks/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.py\""
          }
        ]
      }
    ]
  }
}
